{
	"name": "@valeon-org/obsidian-plugin",
	"version": "1.8.1",
	"private": true,
	"description": "Obsidian plugin for publishing to the Valeon author dashboard.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit",
		"format": "biome check --write .",
		"lint": "biome check .",
		"lint:obsidian": "eslint src",
		"test": "bun test"
	},
	"keywords": [
		"obsidian-plugin"
	],
	"author": "Sayed Hamid Fatimi",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"@types/bun": "^1.4.4",
		"@types/node": "^25.9.1",
		"esbuild": "^0.28.0",
		"eslint": "^10.4.1",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"obsidian": "^1.13.0",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1"
	},
	"dependencies": {},
	"overrides": {
		"moment": "^2.31.0"
	}
}
