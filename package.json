{
	"name": "@valeon-org/obsidian-plugin",
	"version": "1.8.4",
	"private": true,
	"description": "Obsidian plugin for publishing to the Valeon author dashboard.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit",
		"format": "biome check --write .",
		"lint": "biome check .",
		"lint:obsidian": "eslint src",
		"test": "bun test"
	},
	"keywords": [
		"obsidian-plugin"
	],
	"author": "Sayed Hamid Fatimi",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@types/bun": "^1.4.4",
		"@types/node": "^25.9.9",
		"esbuild": "^0.28.2",
		"eslint": "^10.15.0",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"obsidian": "^1.14.4",
		"tslib": "^2.9.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2"
	},
	"dependencies": {},
	"overrides": {
		"minimatch": "^11.0.1",
		"moment": "^2.31.0"
	}
}
